@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Introduction";
}
<div class="col-sm-12">
    <p>
        The Fanex.Grid is a jQuery Grid Plugin, which simplifies rendering Grid on the client site.
    </p>

    <div class="bs-callout bs-callout-info">
        <h4>Supported browsers</h4>
        <p>Fanex.Grid mainly supports these browsers:</p>
        <ul>
            <li><a href="http://windows.microsoft.com/en-us/internet-explorer/download-ie" target="_blank">Internet Explorer 8+</a></li>
            <li><a href="https://www.mozilla.org/fr/firefox/desktop/" target="_blank">FireFox 4.0+</a></li>
            <li><a href="http://www.google.com/chrome/" target="_blank">Chrome 20+</a></li>
        </ul>
    </div>
    <div class="bs-callout bs-callout-warning">
        <h4>Features</h4>
        <p>
           Fanex.Grid supports these features:
        </p>
        <ul>
            <li>Fixed Header and Footer</li>
            <li>Multi-level column group header with colspan and rowspan</li>
            <li>Frozen Columns</li>
            <li>Custom cells formatting and rendering</li>
            <li>Work across browsers</li>
            <li>Sorting</li>
            <li>Paging</li>
            <li>Configurable and customizable</li>
            <li>Grouping</li>
            <li>Title</li>
            <li>Show/Hide Column</li>
            <li>Multiple Language</li>
            <li>Virtual Rendering</li>
        </ul>
    </div>

    <div class="bs-callout bs-callout-info">
        <h4>Install Fanex.Grid</h4>
        <a href="http://nuget.nexcel.vn/packages/Fanex.Grid/" target="_blank">Install-Package Fanex.Grid</a>
    </div>
</div>