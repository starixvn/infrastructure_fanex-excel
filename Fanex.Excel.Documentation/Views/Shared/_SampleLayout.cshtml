<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Font-End Guidelines</title>
    <link href='http://fonts.googleapis.com/css?family=Roboto' rel='stylesheet' type='text/css'>
    @Styles.Render("~/Content/bootstrapcss")
    @Styles.Render("~/Content/materialdesigncss")
    @Styles.Render("~/Content/style")
    @Scripts.Render("~/bundles/modernizr")
    @Styles.Render("~/Content/highlightcss")
    @RenderSection("css", required: false)
</head>
<body class="sample-container">
    <div class="col-sm-12">
        <h1 class="title">@ViewBag.Title</h1>
    </div>

    <div class="col-sm-12">
        @RenderBody()
        <ul id="myTab" class="nav nav-tabs" role="tablist">
            <li role="presentation" class="active">
                <a href="#demo" role="tab" data-toggle="tab">Demo</a>
            </li>
            <li role="presentation" class="">
                <a href="#html" role="tab" data-toggle="tab">Html</a>
            </li>
            <li role="presentation" class="">
                <a href="#css" role="tab" data-toggle="tab">Css</a>
            </li>
            <li role="presentation" class="">
                <a href="#javascript" role="tab" data-toggle="tab">Javascript</a>
            </li>
            <li role="presentation" class="">
                <a href="#csharp" role="tab" data-toggle="tab">C#</a>
            </li>
        </ul>
        <div id="myTabContent" class="tab-content">
            <div class="tab-pane active" id="demo">
                <div id="sourcecontainer">
                    @if (IsSectionDefined("sampleRender"))
                    {
                        @RenderSection("sampleRender")
                    }
                    else
                    {
                        <div class="grid-container">
                            <div id="gridId" class="freegrid">
                            </div>
                        </div>
                    }
                    
                </div>
            </div>
            <div class="tab-pane" id="html">
                    @if (IsSectionDefined("htmlSource"))
                    {
                        @RenderSection("htmlSource")
                    }
                    else
                    {
                        <pre class="brush: html">
                            <div class="grid-container">
                                <div id="gridId" class="freegrid"></div>
                            </div>
                        </pre>
                    }
                
            </div>
            <div class="tab-pane" id="css">
                @if (IsSectionDefined("cssSource"))
                {
                    @RenderSection("cssSource")
                }
                else
                {
                    <pre class="brush: css;" id="css-destination"></pre>
                }
            </div>
            <div class="tab-pane source-panel" id="javascript">
                @if (IsSectionDefined("javascriptSource"))
                {
                    @RenderSection("javascriptSource")
                }
                else
                {
                    <pre class="brush: javascript;" id="javascript-destination"></pre>
                }
                
            </div>
            <div class="tab-pane source-panel" id="csharp">
                @if (IsSectionDefined("csharpSource"))
                {
                    @RenderSection("csharpSource")
                }
                else
                {
                    <pre class="brush: csharp;" id="csharp-destination"></pre>
                }

            </div>
        </div>
    </div>

    @Html.Hidden("FrontEndGuidelinesRootUrl", Url.Content("~/"))
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/materialdesign")
    @Scripts.Render("~/bundles/layoutjs")
    @Scripts.Render("~/bundles/highlightjs")

    <script type="text/javascript">
        $(function () {
            $.material.init();
        });
        SyntaxHighlighter.defaults['toolbar'] = false;
    </script>
    
    <script type="text/javascript">
        $(function () {
            $('#javascript-destination').html($('#javascript-source').html());
            $('#css-destination').html($('#css-source').html());
            $('#csharp-destination').html($('#csharp-source').html());
            SyntaxHighlighter.all();
        });
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>