@{
    string tabName = (string)ViewBag.TabName;
    var displayNoneForToggleIcon = (tabName != "tutorials" && tabName != "samples") ? "style=\"display:none;\"" : string.Empty;
}
<header class="header">
    <nav class="navbar navbar-default" role="navigation">
        <div class="container-fluid">
            <!-- Brand and toggle get grouped for better mobile display -->
            <div class="navbar-header">
                <a class="logo" href="/">
                    Fanex
                    <span> Grid</span>
                </a>
                <i class="mdi-navigation-menu icon-left-panel withripple menu-show" id="toggleMenu" @Html.Raw(displayNoneForToggleIcon)></i>
                <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#topmenu">
                    <i class="mdi-navigation-more-horiz"></i>
                </button>
            </div>
            <!-- Collect the nav links, forms, and other content for toggling -->
            <div class="collapse navbar-collapse" id="topmenu">
                <ul class="nav navbar-nav">
                    <li class="@(tabName == "introduction" ? "active" : string.Empty)">@Html.ActionLink("Introduction", "Index", "Home")</li>
                    <li class="@(tabName == "tutorials" ? "active" : string.Empty)" id="commonControls">@Html.ActionLink("Tutorials", "Index", "Tutorials", new { @tutorialName = 1 }, null)</li>
                    <li class="@(tabName == "samples" ? "active" : string.Empty)">@Html.ActionLink("Samples", "Index", "Samples")</li>
                    <li class="@(tabName == "api" ? "active" : string.Empty)">@Html.ActionLink("API References", "ApiReferences", "Home")</li>
                    <li class="@(tabName == "faq" ? "active" : string.Empty)">@Html.ActionLink("FAQ", "FrequentlyQuestions", "Home")</li>
                </ul>
            </div><!-- /.navbar-collapse -->
        </div><!-- /.container-fluid -->
    </nav>
    <i class="logo"></i>
</header>