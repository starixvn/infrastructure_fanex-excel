@{
    ViewBag.Title = "Format Date Time";
}

@section csharpSource
{
    <pre class="brush: csharp;" id="csharp-source">
        public GridOptions GenerateData()
        {
            this.GenerateHeader();
            this.GenerateBody();
            this.GenerateFooter();
            this._gridOptions.ShowFooter = true;
            return this._gridOptions;
        }

        private void GenerateHeader()
        {
            this._gridOptions.CreateColumns(new HeaderColumns() { HeaderText = "Header 1", Width = 60, Name = "No", CellAlignment = HAlignment.Center });
            this._gridOptions.CreateColumns(new HeaderColumns() { HeaderText = "General", Width = 100, Name = "Text1" });
            this._gridOptions.CreateColumns(new HeaderColumns() { HeaderText = "Datetime", Width = 150, Name = "Datetime", CellAlignment = HAlignment.Right, CustomCellType = ExcelCellType.DateTimeMMDDYYYY });
            this._gridOptions.CreateColumns(new HeaderColumns() { HeaderText = "Integer 1", Width = 100, Name = "Integer1", CellAlignment = HAlignment.Right, CustomCellType = ExcelCellType.Integer });
            this._gridOptions.CreateColumns(new HeaderColumns() { HeaderText = "Integer 2", Width = 100, Name = "Integer2", CellAlignment = HAlignment.Right, CustomCellType = ExcelCellType.IntegerRedNegative });
            this._gridOptions.CreateColumns(new HeaderColumns() { HeaderText = "Integer 3", Width = 100, Name = "Integer3", CellAlignment = HAlignment.Right, CustomCellType = ExcelCellType.IntegerRedparenthesisNegative });
            this._gridOptions.CreateColumns(new HeaderColumns() { HeaderText = "Double 1", Width = 100, Name = "Double1", CellAlignment = HAlignment.Right, CustomCellType = ExcelCellType.Double });
            this._gridOptions.CreateColumns(new HeaderColumns() { HeaderText = "Double 2", Width = 100, Name = "Double2", CellAlignment = HAlignment.Right, CustomCellType = ExcelCellType.DoubleRedNegative });
            this._gridOptions.CreateColumns(new HeaderColumns() { HeaderText = "Double 3", Width = 100, Name = "Double3", CellAlignment = HAlignment.Right, CustomCellType = ExcelCellType.DoubleRedParenthesisNegative });
            this._gridOptions.CreateColumns(new HeaderColumns() { HeaderText = "Percentage 1", Width = 100, Name = "Percentage1", CellAlignment = HAlignment.Right, CustomCellType = ExcelCellType.Percentage });
            this._gridOptions.CreateColumns(new HeaderColumns() { HeaderText = "Percentage 2", Width = 100, Name = "Percentage2", CellAlignment = HAlignment.Right, CustomCellType = ExcelCellType.PercentageRedNegative });
            this._gridOptions.CreateColumns(new HeaderColumns() { HeaderText = "Percentage 3", Width = 100, Name = "Percentage3", CellAlignment = HAlignment.Right, CustomCellType = ExcelCellType.PercentageRedparenthesisNegative });
        }

        private void GenerateBody()
        {
            for (int i = 0; i &gt; 100; i++)
            {
                var bodyRow = new GridDataRow();
                bodyRow.CreateColumns(new Columns() { Name = "No", Value = i });
                bodyRow.CreateColumns(new Columns() { Name = "Text1", Value = RandomString(5) });
                bodyRow.CreateColumns(new Columns() { Name = "Datetime", Value = RandomDateTime() });
                bodyRow.CreateColumns(new Columns() { Name = "Integer1", Value = RandomInteger() });
                bodyRow.CreateColumns(new Columns() { Name = "Integer2", Value = RandomInteger() });
                bodyRow.CreateColumns(new Columns() { Name = "Integer3", Value = RandomInteger() });
                bodyRow.CreateColumns(new Columns() { Name = "Double1", Value = RandomDouble() });
                bodyRow.CreateColumns(new Columns() { Name = "Double2", Value = RandomDouble() });
                bodyRow.CreateColumns(new Columns() { Name = "Double3", Value = RandomDouble() });
                bodyRow.CreateColumns(new Columns() { Name = "Percentage1", Value = RandomDouble(-1, 1) });
                bodyRow.CreateColumns(new Columns() { Name = "Percentage2", Value = RandomDouble(-1, 1) });
                bodyRow.CreateColumns(new Columns() { Name = "Percentage3", Value = RandomDouble(-1, 1) });
                this._gridOptions.CreateBodyRow(bodyRow);
            }
        }

        public void GenerateFooter()
        {
            var footerRow = new GridDataRow();
            footerRow.CreateColumns(new Columns() { Name = "No", Value = "Total" });
            footerRow.CreateColumns(new Columns() { Name = "Text1", Value = RandomString(5) });
            footerRow.CreateColumns(new Columns() { Name = "Datetime", Value = RandomDateTime() });
            footerRow.CreateColumns(new Columns() { Name = "Integer1", Value = RandomInteger() });
            footerRow.CreateColumns(new Columns() { Name = "Integer2", Value = RandomInteger() });
            footerRow.CreateColumns(new Columns() { Name = "Integer3", Value = RandomInteger() });
            footerRow.CreateColumns(new Columns() { Name = "Double1", Value = RandomDouble() });
            footerRow.CreateColumns(new Columns() { Name = "Double2", Value = RandomDouble() });
            footerRow.CreateColumns(new Columns() { Name = "Double3", Value = RandomDouble() });
            footerRow.CreateColumns(new Columns() { Name = "Percentage1", Value = RandomDouble(-1, 1) });
            footerRow.CreateColumns(new Columns() { Name = "Percentage2", Value = RandomDouble(-1, 1) });
            footerRow.CreateColumns(new Columns() { Name = "Percentage3", Value = RandomDouble(-1, 1) });
            this._gridOptions.CreateFooterRow(footerRow);
        }
    </pre>
}

@section scripts
{
    <script src="~/Scripts/Libraries/Moment/moment.min.js"></script>
    <script src="~/Scripts/Libraries/Numeral/numeral.min.js"></script>
    <script type="text/javascript" id="javascript-source">
    $(function () {
        Common.utility.CallAjax(this,
            "../FormatterSample/Generate",
            null,
            function (result) {
                result.showTitle = true;
                result.titleInfo = {
                    text: "Demo Title",
                    showExcelButton: true,
                    exportExcelFunction: function () {
                        Common.downloadFile("../FormatterSample/ExportExcel");
                    }
                }

                $('#gridId').fanexGrid(result);
            });
    });
    </script>
}