@{
    ViewBag.Title = "Text Truncate";
}

@section javascriptSource
{
    <pre class="brush: javascript; highlight: [74, 90, 91]" id="javascript-destination"></pre>
}

@section scripts
{
    <script type="text/javascript" id="javascript-source">
        function generateData(numberRows) {
            var rows = [];
            var currentMerRowNumber = 0;
            var evenClass = '';
            for (var index = 0; index < numberRows; index++) {
                var currentColumms = [];

                if (currentMerRowNumber == 0) {
                    currentMerRowNumber = Math.round(Math.random() * 5) + 2;
                    currentColumms.push({ Name: "No", Value: "Very Long String.......................... end string.", MergeRowNumber: currentMerRowNumber });
                    if (evenClass == 'freegrid-even') {
                        evenClass = '';
                    }
                    else {
                        evenClass = 'freegrid-even';
                    }
                }
                rows.push(
                    {
                        Columns: currentColumms.concat([
                            { Name: "Text1", Value: (Math.random() > 0.5 ? (Math.random() * 500).toFixed(3) : (Math.random() * 500 * -1).toFixed(3)) },
                            { Name: "Number1", Value: (Math.random() * 20000).toFixed(4), MergeColNumber: 2 },
                            { Name: "Number3", Value: (Math.random() * 500).toFixed(3) },
                            { Name: "Text2", Value: Math.random().toString(36).substring(7), MergeColNumber: 3 },
                            { Name: "Number4", Value: (Math.random() * 1000).toFixed(3) },
                            { Name: "Number5", Value: (index % 2 == 0 ? (Math.random() * 500).toFixed(3) : (Math.random() * 500 * -1).toFixed(3)) }
                        ]),
                        CssClass: evenClass
                    }
                );
                currentMerRowNumber--;
            }
            return rows;
        }

        var footerRows = [
                  {
                      Columns: [
                        { Value: "Total", Name: "No", MergeColNumber: 2 },
                        { Value: "Footer 3 very long string. ......", Name: "Number1" },
                        { Value: "Footer 4", Name: "Number2", MergeRowNumber: 2 },
                        { Value: "Footer 5", Name: "Number3", MergeRowNumber: 2 },
                        { Value: "Footer Merge 6", Name: "Text2", MergeColNumber: 3, CellAlign: 'center' },
                        { Value: "Footer 9", Name: "Number4" },
                        { Value: "Footer 10", Name: "Number5" }
                      ]
                  },
                {
                    Columns: [
                    { Value: "Total 2", Name: "No", MergeColNumber: 3 },
                    { Value: "Footer 6", Name: "Text2" },
                    { Value: "Footer 7", Name: "Text3" },
                    { Value: "Footer 8", Name: "Text4" },
                    { Value: "Footer Merge 9 very long string ", Name: "Number4", MergeColNumber: 2 }
                    ]
                }
        ];

        var gridOptions =
            {
                customizeHeader: true,
                groupHeaderRows: [
                         {
                             Columns: [
                                    { HeaderText: "Group Header 1", Name: "No", MergeColNumber: 2 },
                                    { HeaderText: "Header 3", Name: "Number1", MergeRowNumber: 2 },
                                    { HeaderText: "Header 4", Name: "Number2", MergeRowNumber: 2 },
                                    { HeaderText: "Group Header 2", Name: "Number3", MergeColNumber: 5 },
                                    { HeaderText: "Header 10", Name: "Number5", MergeRowNumber: 2 }
                             ]
                         }
                ],
                columns: [
                    { HeaderText: "Header 1", Width: 120, Name: "No", HeaderAlign: "center", CellAlign: "center", AllowTruncate: true },
                    { HeaderText: "Header 2", Width: 140, Name: "Text1", HeaderAlign: "center", CellAlign: "right" },
                    { HeaderText: "Header 3", Width: 130, Name: "Number1", HeaderAlign: "center", CellAlign: "right" },
                    { HeaderText: "Header 4", Width: 140, Name: "Number2", HeaderAlign: "center", CellAlign: "right" },
                    { HeaderText: "Header 5", Width: 160, Name: "Number3", HeaderAlign: "center", CellAlign: "right" },
                    { HeaderText: "Header 6", Width: 130, Name: "Text2" },
                    { HeaderText: "Header 7", Width: 140, Name: "Text3" },
                    { HeaderText: "Header 8", Width: 150, Name: "Text4" },
                    { HeaderText: "Header 9", Width: 140, Name: "Number4", HeaderAlign: "center", CellAlign: "right" },
                    { HeaderText: "Header 10", Width: 120, Name: "Number5", HeaderAlign: "center", CellAlign: "right" }
                ],
                bodyRows: generateData(200),
                gridExpandHeight: 150,
                numberOfFrozenColumn: 4,
                showFooter: true,
                footerRows: footerRows,
                showDistinctRow: false,
                allowTruncate: true //// Set all column, recommend that if there is only column need be set, 
                //// then only set to that column, set AllowTruncate: true, see example above
            };

        $(function () {
            var currentGrid = $("#gridId").fanexGrid(gridOptions);
        });
    </script>
}
