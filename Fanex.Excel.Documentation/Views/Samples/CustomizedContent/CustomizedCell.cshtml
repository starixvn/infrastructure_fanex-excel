@{
    ViewBag.Title = "Customized Cell";
    Layout = "~/Views/Shared/_SampleLayout.cshtml";
}

@section css
{
    <style type="text/css" id="css-source">
         .freegrid .free-top-left table thead th.demo-class,
         .freegrid .col_header table thead th.demo-class {
             background: #ff0000;
             background: -moz-linear-gradient(#ff0000, #ff0000) #ff0000;
             background: -webkit-linear-gradient(#ff0000, #ff0000) #ff0000;
             color: #4cff00;
         }

         .freegrid .row_footer table thead tr th.footer-class,
         .freegrid .col_footer table thead tr th.footer-class {
             background: #ff0000 !important;
             background: -moz-linear-gradient(#ff0000, #ff0000) #ff0000 !important;
             background: -webkit-linear-gradient(#ff0000, #ff0000) #ff0000 !important;
             color: #4cff00;
         }

         .freegrid .grid-fixed-table td.cell-td-class,
         .freegrid .grid-fixed-table td.cell-td-class:hover {
             background: #00ff90 !important;
         }

         .cell-content-class {
             color: #0026ff;
             font-weight: bold;
         }
    </style>
}

@section javascriptSource
{
    <pre class="brush: javascript; highlight: [8, 9, 23, 34, 37, 40, 47, 62, 67, 80]" id="javascript-destination"></pre>
}

@section scripts
{
    <script type="text/javascript" id="javascript-source">
        //// Setup Grid options
        var gridOptions =
       {
           customizeHeader: true,
           groupHeaderRows: [
                    {
                        Columns: [
                               { HeaderText: "Group Header 1", Name: "No", MergeColNumber: 2, ThClass: 'demo-class' },
                               { HeaderText: "Header 3", Name: "Number1", MergeRowNumber: 2, ThClass: 'demo-class' },
                               { HeaderText: "Header 4", Name: "Number2", MergeColNumber: 2 },
                               { HeaderText: "Group Header 2", Name: "Text2", MergeColNumber: 3 },
                               { HeaderText: "Header 10", Name: "Number4", MergeRowNumber: 2 },
                               { HeaderText: "Header 10", Name: "Number5", MergeRowNumber: 2 }
                        ]
                    }
           ],
           columns: [
               { HeaderText: "Header 1", Width: 60, Name: "No", HeaderAlign: "center", CellAlign: "center" },
               { HeaderText: "Header 2", Width: 70, Name: "Text1", HeaderAlign: "center", CellAlign: "right" },
               { HeaderText: "Header 3", Width: 100, Name: "Number1", HeaderAlign: "center", CellAlign: "right" },
               { HeaderText: "Header 4", Width: 100, Name: "Number2", MergeHeaderColNumber: 2 },
               { HeaderText: "Header 5", Width: 160, Name: "Number3", HeaderAlign: "center", CellAlign: "right" },
               { HeaderText: "Header 6", Width: 110, Name: "Text2", MergeHeaderColNumber: 3, ThClass: 'demo-class' },
               { HeaderText: "Header 7", Width: 120, Name: "Text3" },
               { HeaderText: "Header 8", Width: 150, Name: "Text4" },
               { HeaderText: "Header 9", Width: 90, Name: "Number4", HeaderAlign: "center", CellAlign: "right" },
               { HeaderText: "Header 10", Width: 120, Name: "Number5", HeaderAlign: "center", CellAlign: "right" }
           ],
           bodyRows: [
               {
                   Columns: [
                      { Name: "No", Value: 1 },
                      { Name: "Text1", Value: "Body 1" },
                      { Name: "Number1", Value: 1, TdClass: 'cell-td-class' },
                      { Name: "Number2", Value: 2 },
                      { Name: "Number3", Value: 3 },
                      { Name: "Text2", Value: "Body 2", CustomAttr: "data-attr='CustomAttr'" },
                      { Name: "Text3", Value: "Body 3" },
                      { Name: "Text4", Value: "Body 4" },
                      { Name: "Number4", Value: 4, CustomAttr: "data-attr='CustomAttr1'" },
                      { Name: "Number5", Value: 5 }
                   ]
               },
               {
                   Columns: [
                       { Name: "No", Value: 2 },
                       { Name: "Text1", Value: "Body 1", TdClass: 'cell-td-class' },
                       { Name: "Number1", Value: 1 },
                       { Name: "Number2", Value: 2 },
                       { Name: "Number3", Value: 3 },
                       { Name: "Text2", Value: "Body 2" },
                       { Name: "Text3", Value: "Body 3" },
                       { Name: "Text4", Value: "Body 4" },
                       { Name: "Number4", Value: 4 },
                       { Name: "Number5", Value: 5 }
                   ]
               },
               {
                   Columns: [
                       { Name: "No", Value: 2 },
                       { Name: "Text1", Value: "Body 1"},
                       { Name: "Number1", Value: 123232, CssClass: "cell-content-class" },
                       { Name: "Number2", Value: 2 },
                       { Name: "Number3", Value: 3 },
                       { Name: "Text2", Value: "Body 2" },
                       { Name: "Text3", Value: "Body 3" },
                       { Name: "Text4", Value: "Body 4", TdClass: 'cell-td-class' },
                       { Name: "Number4", Value: 4 },
                       { Name: "Number5", Value: 5 }
                   ]
               }
           ],
           gridExpandHeight: 120,
           showFooter: true,
           footerRows: [{
               Columns: [
                       { Name: "No", Value: "Total" },
                       { Name: "Text1", Value: "Footer 1" },
                       { Name: "Number1", Value: 1 },
                       { Name: "Number2", Value: 2, TdClass: 'footer-class' },
                       { Name: "Number3", Value: 3 },
                       { Name: "Text2", Value: "Footer 2" },
                       { Name: "Text3", Value: "Footer 3" },
                       { Name: "Text4", Value: "Footer 4" },
                       { Name: "Number4", Value: 4 },
                       { Name: "Number5", Value: 5 }
               ]
           }]
       };

        $(function () {
            //// Render
            $("#gridId").fanexGrid(gridOptions);
        });
    </script>

}








